# Copy to .env and fill in real values. Never commit .env.
#
# The Fresh web app reads data/*.json and needs only the two login variables
# in the first block. Everything else is used by the Python pipeline in
# pipeline/.

# --- Web app login ----------------------------------------------------------
# Read by routes/_middleware.ts and routes/login.tsx; `deno task dev` loads
# this file itself. Both are required: with either missing the gate fails
# closed and every route answers 503. On Deno Deploy they are Secrets in the
# Production context (and a second pair in Development, for preview URLs).
# Failed sign-ins are limited in this server process (five per socket client
# and 64 total per minute), but restarts clear the counters and replicas each
# have their own allowance, so still make the passphrase a sentence. The
# session secret signs the 30-day cookie; rotating it logs everyone out.
# `openssl rand -base64 32`.
DASHBOARD_PASSPHRASE=
DASHBOARD_SESSION_SECRET=

# --- PostgreSQL -------------------------------------------------------------
# Read by pipeline/database.py and pipeline/alembic/env.py.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=csvd_dashboard
DB_USER=
DB_PASSWORD=

# --- Anthropic API ----------------------------------------------------------
# LLM gene extraction (pipeline/anthropic_client.py).
ANTHROPIC_API_KEY=sk-ant-...
# Only for an identity-linked key, which does not imply a workspace: without
# it every request is rejected with "anthropic-workspace-id is required". A
# workspace-scoped key carries its own workspace and needs nothing here.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# --- NCBI Entrez ------------------------------------------------------------
# ENTREZ_EMAIL is required by NCBI policy; pubmed_search.py warns without it.
ENTREZ_EMAIL=your_email@example.com
NCBI_API_KEY=your_ncbi_api_key
# Optional. Only pubmed_search.py reads it, and it falls back to NCBI_API_KEY.
# ENTREZ_KEY=

# --- Unpaywall --------------------------------------------------------------
# Open-access PDF lookup. Without it pdf_retrieval.py skips the Unpaywall step.
UNPAYWALL_EMAIL=your_email@example.com

# --- Extraction (Claude) ----------------------------------------------------
# The model is NOT an environment variable. It is pinned in pipeline/config.py
# as EXTRACTION_MODEL, because extraction output is compared across runs,
# against recorded cassettes and against a gold standard -- a per-machine
# override would make two runs of the same code incomparable silently.
# Effort is the cost lever: "high" is the default, and "low" / "medium" buy a
# large token saving. Also "xhigh" and "max".
# PIPELINE_LLM_EFFORT=high
# Drop any gene whose source_quote is not verbatim in the paper. Measured
# across the ten golden fixtures: 137/138 quotes are verbatim, so this gate
# costs one gene. (It does NOT gate on the API citation match, which reaches
# only 45/138 -- the API returns a handful of spans per paper however many
# genes are found, so that number measures prose volume, not quote quality.)
# Default false so a failure is seen before a gene is lost.
# PIPELINE_REQUIRE_VERIFIED_QUOTES=false
# Paper text is truncated to this many chars. 400,000 is ~100K tokens of a
# 1M-token context; the old 100,000 was sized for a 200K window. The largest
# corpus paper to date is ~80,000 chars, so this is a ceiling rather than an
# active limit -- but an unbounded paper is an unbounded bill.
# PIPELINE_MAX_PAPER_TEXT_CHARS=400000
# The confidence floor is two numbers, because it decides two things whose
# risks are opposite. Adding a reference to a gene already in the table is
# cheap and reversible; creating a new curated row is a published claim.
# 0.45 is where gold recall saturates -- measured over the ten cassettes,
# where 0.65 cost eight gold genes (89% -> 72%).
# PIPELINE_CONFIDENCE_THRESHOLD_UPDATE=0.45
# Not swept, and not to be: the gold standard cannot tell an incorrect new
# gene from an unreviewed one. 0.65 is a curation policy.
# PIPELINE_CONFIDENCE_THRESHOLD_INSERT=0.65

# --- PDF fallback (Docling) -------------------------------------------------
# Read by pipeline/config.py; all optional. OCR is a fallback, not a mode --
# Docling skips layout regions that already carry programmatic text, so a
# born-digital paper pays ~79% for byte-identical output, while a scanned one
# recovers ~97% of content that would otherwise be lost entirely.
# PIPELINE_PDF_OCR=true
# CoreML measured 1.65x SLOWER than CPU on Apple Silicon (PP-OCR uses dynamic
# input shapes, which CoreML falls back to CPU for). Re-measure before enabling.
# PIPELINE_PDF_OCR_COREML=false
# auto | cpu | mps | xpu | cuda | cuda:N
# PIPELINE_PDF_DEVICE=auto
# Defaults to the count of *performance* cores (8 on an M1 Pro), not every
# core: os.cpu_count() reports 10 there, and 10 threads measured 18% slower
# than the old default of 4, because the 2 efficiency cores drag a
# compute-bound stage down. Raise only with measurements.
# PIPELINE_PDF_NUM_THREADS=
# Bounds conversion; pdf_retrieval's PDF_TIMEOUT bounds only the download.
# PIPELINE_PDF_TIMEOUT_SECONDS=120
# Pages beyond this are truncated, not rejected.
# PIPELINE_PDF_MAX_PAGES=200
# Pin the model weights somewhere fixed. Empty uses ~/.cache/docling/models,
# which `deno task models` populates.
# PIPELINE_PDF_ARTIFACTS_PATH=

# --- Annotation sources (`--sync-annotations`) ------------------------------
# Concurrent requests per source. ClinVar rides the E-utilities, so its limit
# is NCBI's; the other two are the services' own.
# PIPELINE_CLINVAR_RATE_LIMIT=10
# Records per gene fetched from ClinVar. The largest of the 63 curated genes
# returns 248, so this is a census rather than a sample; a gene that exceeds
# it is flagged truncated and its record counts are a floor, not a total.
# PIPELINE_CLINVAR_MAX_RECORDS=500
# Orphadata is enrichment, keyed by the ORPHAcodes ClinVar returns -- it has
# no gene endpoint of its own, so it never runs before ClinVar.
# PIPELINE_ORPHADATA_RATE_LIMIT=5
# PIPELINE_OPENTARGETS_RATE_LIMIT=5
# The Open Targets API self-describes as Beta and its schema has already
# shifted once. Every fetched row records the version it came from, and the
# sync warns when the live version is not this one.
# PIPELINE_OPENTARGETS_DATA_VERSION=26.06
# Associations per gene. The API ranks them, so the top N is a documented
# ranking rather than a sample -- HTRA1 alone has 490.
# PIPELINE_OPENTARGETS_MAX_DISEASES=25

# --- Optional overrides -----------------------------------------------------
# Where pipeline/main.py writes run logs. Defaults to <repo root>/logs.
# PIPELINE_LOG_DIR=
# TLS bundle. main.py falls back to certifi when this is unset.
# SSL_CERT_FILE=
