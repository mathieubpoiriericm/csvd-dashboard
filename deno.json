{
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "deno run -A --env-file=.env npm:vite",
    "build": "vite build",
    "start": "deno serve -A --host 127.0.0.1 --env-file=.env _fresh/server.js",
    "check": "deno fmt --check . && deno lint . && deno check && deno check e2e/fixtures/expected.deno.ts",
    "test": "deno test -A",
    "test:coverage": "deno test -A --coverage=coverage --clean --coverage-raw-data-only && deno coverage coverage && deno coverage --include='/lib/' --threshold=100 coverage",
    "test:e2e": "cd e2e && npx playwright test",
    "test:e2e:ui": "cd e2e && npx playwright test --ui",
    "e2e:install": "cd e2e && npm ci && npx playwright install chromium",
    "test:perf": "node --test e2e/perf/*.test.mjs",
    "perf": "deno task build && node e2e/perf/run.mjs",
    "screenshots": "deno task build && node e2e/screenshots.mjs",
    "models": "uv run docling-tools models download layout tableformer rapidocr --rapidocr-backend-lang onnxruntime:en",
    "data": "uv run python -m pipeline.export.main",
    "data:empty": "uv run python -m pipeline.export.empty",
    "geocode": "uv run python -m pipeline.export.geocode",
    "cytobands": "uv run scripts/fetch_cytobands.py && deno fmt data/cytobands_hg38.json",
    "fixtures": "uv run python -m scripts.fetch_paper_fixtures",
    "figure": "uv run --group figure scripts/timeline_figure.py && uv run --group figure scripts/phenogram_figure.py",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "coverage": {
    "thresholds": {
      "lines": 85,
      "branches": 95,
      "functions": 90
    }
  },
  "fmt": {
    "exclude": [
      "disease/prompt.md"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    "e2e",
    "!e2e/fixtures/expected.deno.ts",
    ".claude",
    ".venv",
    "tests/pipeline/cassettes",
    "tests/pipeline/csvd/cassettes"
  ],
  "imports": {
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/http": "jsr:@std/http@^1.1.3",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "preact": "npm:preact@^10.29.8",
    "vite": "npm:vite@^7.3.6",
    "@tanstack/preact-table": "npm:@tanstack/preact-table@^9.2.4",
    "@tanstack/table-core": "npm:@tanstack/table-core@^9.2.4",
    "leaflet": "npm:leaflet@^1.9.4",
    "leaflet.markercluster": "npm:leaflet.markercluster@^1.5.3",
    "@types/leaflet": "npm:@types/leaflet@^1.9.22",
    "@types/leaflet.markercluster": "npm:@types/leaflet.markercluster@^1.5.6",
    "@types/node": "npm:@types/node@^22.20.4",
    "@floating-ui/dom": "npm:@floating-ui/dom@^1.8.0",
    "fflate": "npm:fflate@^0.8.3",
    "preact-render-to-string": "npm:preact-render-to-string@^6.6.3",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
